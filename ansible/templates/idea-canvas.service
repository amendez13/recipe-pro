[Unit]
Description=Recipe Pro (FastAPI)
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
User={{ app_user }}
Group={{ app_group }}
WorkingDirectory={{ app_dir }}
Environment=PYTHONUNBUFFERED=1
ExecStart={{ app_dir }}/.venv/bin/uvicorn app.app:app --host {{ app_host }} --port {{ app_port }}
Restart=always
RestartSec=10
SyslogIdentifier={{ service_name }}

[Install]
WantedBy=multi-user.target
